# rustfmt.toml requires Unix newlines. Keep Windows checkouts from rewriting
# Rust sources before the formatting check runs.
*.rs text eol=lf

# Public API snapshots are generated with LF-only output and compared byte for
# byte.
public-api/*.txt text eol=lf
