# The formatters emit Unix newlines. Keep GitHub-hosted Windows and developer
# checkouts from rewriting detected text files before policy checks run.
* text=auto eol=lf

# Public API snapshots are generated with LF-only output and compared byte for
# byte.
public-api/*.txt text eol=lf
